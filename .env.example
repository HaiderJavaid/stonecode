# Supabase (server-only service key; never expose it to Vite/client code)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Managed OpenAI provider
OPENAI_API_KEY=replace-with-server-api-key
OPENAI_MODEL=gpt-5.6-luna
# Finalized Course, Guided Project, and Exercise Pack generation only. Proposals stay Standard. Set default to disable the Fast-tier premium.
OPENAI_COURSE_GENERATION_SERVICE_TIER=fast
OPENAI_MODEL_EMBEDDING=text-embedding-3-small
OPENAI_IMAGE_MODEL=gpt-image-1

# Stripe Pro subscription
STRIPE_SECRET_KEY=sk_live_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
STRIPE_PRO_PRICE_ID=price_replace-me
STRIPE_SUCCESS_URL=https://your-domain.example/settings/billing
STRIPE_CANCEL_URL=https://your-domain.example/settings/billing
STRIPE_PORTAL_RETURN_URL=https://your-domain.example/settings/billing

# Background generation worker; generate at least 32 random characters
STONECODE_INTERNAL_JOB_SECRET=replace-with-a-long-random-server-secret

# Support and operations (server alert webhook is optional but recommended in production)
VITE_SUPPORT_EMAIL=support@your-domain.example
STONECODE_ALERT_WEBHOOK_URL=https://your-alert-receiver.example/stonecode

# Judge0 CE through RapidAPI. X-RapidAPI-Key is the credential; no second Judge0 secret is required.
CODE_RUNNER_PROVIDER=judge0
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=replace-with-rapidapi-key
JUDGE0_API_KEY_HEADER=X-RapidAPI-Key
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
JUDGE0_GLOBAL_ACTIONS_PER_DAY=1000

# Execution guardrails
EXECUTION_TIMEOUT_MS=5000
EXECUTION_MEMORY_KB=131072
EXECUTION_OUTPUT_LIMIT=32000
EXECUTION_CODE_LIMIT=64000
EXECUTION_STDIN_LIMIT=8000
EXECUTION_RUNS_PER_MINUTE=20

# Rollout flags default off in production; enable gradually after readiness passes.
FEATURE_CREDITS_V1=false
FEATURE_LEARNING_PROPOSALS_V1=false
FEATURE_RUNTIME_CATALOG_V1=false
FEATURE_STRUCTURED_TUTOR_TOOLS=false
FEATURE_CHAT_VISUALS_V1=false
FEATURE_DYNAMIC_SURFACES=false
FEATURE_MARKETPLACE_V1=false
